  "components": [
    {
      "name": "Reader source action",
      "kind": "button",
      "refersTo": "button-small",
      "description": "Compact source action; transparent behavior remains native to a button.",
      "html": "<button class=\"ds-source-action\">Chọn làm nguồn</button>",
      "css": ".ds-source-action{font-family:Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;gap:5px;border:0;border-radius:5px;padding:7px 9px;font-size:10px;cursor:pointer;white-space:nowrap;background:#24352a;color:#d0e0d3}.ds-source-action:focus-visible{outline:2px solid var(--focus,#f1cb79);outline-offset:3px;}"
    },
    {
      "name": "Selected reader action",
      "kind": "button",
      "refersTo": "button-small-selected",
      "description": "Selected source uses a check and explicit label.",
      "html": "<button class=\"ds-source-selected\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Đã chọn nguồn</button>",
      "css": ".ds-source-selected{font-family:Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;gap:5px;border:0;border-radius:5px;padding:7px 9px;font-size:10px;cursor:pointer;white-space:nowrap;background:#494328;color:#f2ce87}.ds-source-selected:focus-visible{outline:2px solid var(--focus,#f1cb79);outline-offset:3px;}"
    },
    {
      "name": "Icon action",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Neutral icon control with hover and keyboard focus.",
      "html": "<button class=\"ds-icon\" aria-label=\"Bỏ nguồn\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg></button>",
      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;min-width:32px;min-height:32px;border:0;border-radius:5px;background:transparent;color:#b9c9be;cursor:pointer}.ds-icon:hover{background:#2a3b30;color:#fff}.ds-icon:focus-visible{outline:2px solid var(--focus,#f1cb79);outline-offset:3px;}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Search border changes on focus within; Ctrl K hint is desktop-only in the app.",
      "html": "<div class=\"ds-search\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.34-4.34\"/></svg><input aria-label=\"Tìm ghi chú\" placeholder=\"Tìm trong tiêu đề, nội dung, tags…\"/></div>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;border:1px solid #45584a;border-radius:7px;padding:0 12px;background:#19251e;color:#a8bcae;min-height:43px}.ds-search:focus-within{border-color:var(--accent,#e3b75a)}.ds-search input{font-family:Arial,Helvetica,sans-serif;flex:1;min-width:0;border:0;background:transparent;color:var(--text,#e9eee9);font-size:13px;padding:12px 0;outline:none;caret-color:var(--accent,#e3b75a)}.ds-search input::placeholder{color:#a5b6aa}"
    },
    {
      "name": "Category filters",
      "kind": "chip",
      "refersTo": "filter-active",
      "description": "Pressed state is explicit and visually distinct.",
      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Loại nguồn\"><button class=\"ds-filter\" aria-pressed=\"true\">Tất cả</button><button class=\"ds-filter\" aria-pressed=\"false\">Ghi chú cá nhân</button></div>",
      "css": ".ds-filters{display:flex;gap:4px}.ds-filter{font-family:Arial,Helvetica,sans-serif;border:0;background:transparent;color:#b8c7bc;font-size:11px;padding:7px 9px;border-radius:5px;white-space:nowrap;cursor:pointer}.ds-filter:hover{background:#26362c}.ds-filter[aria-pressed=true]{background:#38472e;color:#f2cb7e}.ds-filter:focus-visible{outline:2px solid var(--focus,#f1cb79);outline-offset:3px;}"
    },
    {
      "name": "Library navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Active library item with a monospaced source count.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Nhóm ghi chú\"><button class=\"ds-nav-item ds-active\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v16\"/><path d=\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z\"/></svg>Thư viện<span class=\"ds-nav-count\">35</span></button><button class=\"ds-nav-item\">Ghi chú</button></nav>",
      "css": ".ds-nav{background:var(--rail,#14231d);padding:14px;display:flex;flex-direction:column;gap:4px}.ds-nav-item{font-family:Arial,Helvetica,sans-serif;display:flex;align-items:center;gap:10px;border:0;background:none;color:#c0cfc4;padding:11px 12px;border-radius:6px;text-align:left;font-size:13px;min-height:40px;cursor:pointer}.ds-nav-item:hover{background:#20352a;color:#fff}.ds-nav-item.ds-active{background:#344431;color:#f3ce87}.ds-nav-item:focus-visible{outline:2px solid var(--focus,#f1cb79);outline-offset:3px;}.ds-nav-count{margin-left:auto;font-size:11px;font-family:var(--mono,ui-monospace,SFMono-Regular,Consolas,monospace);}"
    },
    {
      "name": "Reader code container",
      "kind": "card",
      "refersTo": "code-block",
      "description": "Focusable bordered code container with horizontal overflow.",
      "html": "<pre class=\"ds-code\" tabindex=\"0\"><code>const evidence = {\n  source: \"ghi-chu-duoc-chon\",\n  verified: false,\n};</code></pre>",
      "css": ".ds-code{overflow:auto;white-space:pre;max-width:100%;border:1px solid #3a4c40;background:#101913;border-radius:7px;padding:17px;margin:20px 0;tab-size:2}.ds-code code{font-family:var(--mono,ui-monospace,SFMono-Regular,Consolas,monospace);font-size:12px;line-height:1.75;background:none;padding:0;color:#cfe3cd;overflow-wrap:normal}.ds-code:focus-visible{outline:2px solid var(--focus,#f1cb79);outline-offset:3px;}"
    },
    {
      "name": "Question field",
      "kind": "input",
      "refersTo": "question-field",
      "description": "Draft-only question input; no AI submission is implied.",
      "html": "<textarea class=\"ds-question\" aria-label=\"Câu hỏi của bạn\" maxlength=\"4000\" placeholder=\"Điều gì cần làm rõ từ những nguồn này?\"></textarea>",
      "css": ".ds-question{font-family:Arial,Helvetica,sans-serif;width:100%;height:100px;resize:vertical;min-height:80px;max-height:220px;border:1px solid #52664f;background:#111d14;border-radius:7px;padding:12px;color:#e6efe6;font-size:12px;line-height:1.65;caret-color:var(--accent,#e3b75a)}.ds-question::placeholder{color:#a9bdad}.ds-question:focus-visible{outline:2px solid var(--focus,#f1cb79);outline-offset:3px;}"
    },
    {
      "name": "Unconnected send control",
      "kind": "button",
      "refersTo": "button-send-disabled",
      "description": "Only the shipped disabled state; there is no enabled-send design.",
      "html": "<button class=\"ds-send\" disabled aria-describedby=\"ds-send-reason\">Chưa thể gửi</button><p class=\"ds-send-reason\" id=\"ds-send-reason\">Cần chọn provider và xác minh kết nối. Không có câu trả lời AI giả.</p>",
      "css": ".ds-send{font-family:Arial,Helvetica,sans-serif;width:100%;display:flex;justify-content:center;align-items:center;gap:8px;background:#344630;color:#becbb2;border:1px solid #53654a;border-radius:6px;padding:11px;font-size:12px;cursor:not-allowed}.ds-send-reason{font-family:Arial,Helvetica,sans-serif;color:#b4c8b8;font-size:10px;line-height:1.65;margin:10px 0 0}"
    },
    {
      "name": "Chosen-source row",
      "kind": "custom",
      "refersTo": "chosen-source",
      "description": "Source title and revision stay visible together; example content is synthetic.",
      "html": "<div class=\"ds-chosen\"><div><button class=\"ds-chosen-title\">Ghi chú minh họa</button><small class=\"ds-chosen-meta\">Ví dụ mẫu · 019906da</small></div><button class=\"ds-remove\" aria-label=\"Bỏ nguồn Ghi chú minh họa\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg></button></div>",
      "css": ".ds-chosen{font-family:Arial,Helvetica,sans-serif;display:flex;gap:8px;border-bottom:1px solid #374c3c;padding:13px 0;align-items:flex-start;background:#19261d;color:#c3d8c8}.ds-chosen>div{min-width:0;flex:1}.ds-chosen-title{font-family:Arial,Helvetica,sans-serif;background:none;border:0;color:#e7eee7;font-size:11px;line-height:1.5;text-align:left;padding:0;cursor:pointer}.ds-chosen-meta{display:block;font-family:var(--mono,ui-monospace,SFMono-Regular,Consolas,monospace);font-size:9px;line-height:1.65;color:#adc2b2;margin-top:5px;overflow-wrap:anywhere}.ds-remove{display:inline-flex;align-items:center;justify-content:center;min-width:24px;min-height:24px;border:0;border-radius:5px;background:transparent;color:#b9c9be;cursor:pointer}.ds-remove:hover{background:#2a3b30;color:#fff}.ds-chosen-title:focus-visible,.ds-remove:focus-visible{outline:2px solid var(--focus,#f1cb79);outline-offset:3px;}"
    }
  ],
  "narrative": {
    "northStar": "Nguồn cạnh câu hỏi",
    "overview": "“Nguồn cạnh câu hỏi” is the confirmed direction for this personal web workspace. Its dark default combines green-charcoal task panels, warm amber selection and readable working text. Familiar table, reading and form controls express the developer-oriented brief without a simulated terminal or decorative neon.\n\nThe reusable identity is selected-source continuity: a note stays recognizable in the library, reader and question context through its title, checked state and revision metadata. Reading remains useful while AI is unconnected. The source body and assistant area retain separate visual roles; no generated answer or connected-provider treatment is implied by a draft field.",
    "keyCharacteristics": [
      "Dark green-charcoal panels separated by fine rules.",
      "Compact working controls with a calmer, longer-line-height reader.",
      "Amber selection paired with checkboxes, labels and source counts.",
      "Sans UI and prose; monospace paths, revisions, counts and code.",
      "Truthful read-only, unconnected, empty, stale and recovery states."
    ],
    "rules": [
      {
        "name": "The Selection Continuity Rule",
        "body": "Use amber with explicit checked or selected labels across the source table, reader action and question-source count; color alone is not the source identity.",
        "section": "colors"
      },
      {
        "name": "The Metadata Separation Rule",
        "body": "Keep paths, hashes, counts and code in monospace; keep reading prose and working controls in the sans stack.",
        "section": "typography"
      },
      {
        "name": "The Tonal Panel Rule",
        "body": "Separate working regions through dark surface tones and thin borders, without adding drop shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do carry the selected note title, revision and selection state between library, reader and assistant.",
      "Do keep dark as the default, and use the existing green-charcoal surfaces with restrained amber states.",
      "Do keep a visible focus indicator, a labeled control and a concrete destination for a source handoff.",
      "Do preserve selected sources and the question draft while changing the mobile task tab.",
      "Do distinguish actual note content, labeled illustration data, unconnected AI and stale source revisions.",
      "Do let the note reader and code blocks scroll independently inside the available viewport."
    ],
    "donts": [
      "Don't turn the developer brief into a fake terminal, decorative neon or fabricated metrics.",
      "Don't present the disabled send control as an available AI action or invent a provider/model choice.",
      "Don't use source-category or revision metadata as a decorative heading pattern on unrelated surfaces.",
      "Don't apply monospace to all prose or treat Arial as a distinctive brand display face.",
      "Don't replace the current tonal depth with decorative shadows or floating cards.",
      "Don't treat the superseded light concept sketch as color authority."
    ]
  }
}
