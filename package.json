{
  "name": "andrew-ts-tools",
  "private": true,
  "description": "Andrew TS Tools: check-ticket workflow scripts and Hachimi database tooling",
  "scripts": {
    "db:up": "docker compose -f db/docker-compose.yml up -d",
    "db:down": "docker compose -f db/docker-compose.yml down",
    "db:migrate": "node scripts/hachimi-db.mjs migrate",
    "db:status": "node scripts/hachimi-db.mjs status",
    "docs:ingest": "node scripts/hachimi-docs-ingest.mjs",
    "docs:search": "node scripts/hachimi-docs-search.mjs",
    "trace:sync": "node scripts/hachimi-trace-sync.mjs",
    "trace:web": "node scripts/hachimi-trace-web.mjs",
    "trace:web:install": "node scripts/install-hachimi-trace-web.mjs",
    "trace:send": "node scripts/hachimi-trace-client.mjs",
    "trace:purge": "node scripts/hachimi-trace-store-cli.mjs purge",
    "trace:logo": "python3 scripts/generate-trace-logo.py",
    "trace:domain": "node scripts/hachimi-trace-domain.mjs",
    "trace:test": "node scripts/hachimi-trace-web.test.mjs",
    "history:test": "node --test scripts/check-ticket-history.test.mjs",
    "checking:test": "node --test scripts/checking-ticket.test.mjs",
    "analytics:test": "node --test scripts/hachimi-analytics-store.test.mjs",
    "feature:test": "node --test scripts/feature-section.test.mjs",
    "speech:test": "node --test scripts/hanlead-speech.test.mjs",
    "news:test": "node --test scripts/news-feed.test.mjs scripts/news-tips.test.mjs",
    "news:build": "node scripts/news-store.mjs build",
    "dfu:test": "node --test scripts/dfu-accessibility-store.test.mjs",
    "web:start": "node scripts/ts-management-web.mjs",
    "web:install": "node scripts/install-ts-management-web.mjs",
    "web:uninstall": "node scripts/install-ts-management-web.mjs --uninstall",
    "devfollow:preview": "node skills/dev-fix-follow/scripts/run.mjs --preview",
    "devfollow:test": "node --test scripts/dev-fix-follow.test.mjs",
    "devfollow:install": "node scripts/install-dev-fix-follow.mjs",
    "devfollow:uninstall": "node scripts/install-dev-fix-follow.mjs --uninstall",
    "featfollow:preview": "node skills/feature-follow/scripts/run.mjs --preview",
    "featfollow:test": "node --test scripts/feature-follow.test.mjs",
    "featfollow:install": "node scripts/install-feature-follow.mjs",
    "featfollow:uninstall": "node scripts/install-feature-follow.mjs --uninstall",
    "appsdoc:sync": "node scripts/apps-doc-sync-if-due.mjs --run --force --source manual",
    "appsdoc:sync:check": "node scripts/apps-doc-sync-if-due.mjs --check",
    "appsdoc:sync:test": "node --test scripts/apps-doc-sync.test.mjs",
    "appsdoc:sync:install": "node scripts/install-apps-doc-sync.mjs",
    "appsdoc:sync:enable": "node scripts/install-apps-doc-sync.mjs --enable",
    "appsdoc:sync:uninstall": "node scripts/install-apps-doc-sync.mjs --uninstall",
    "v2:test": "node --test skills/check-ticket-v2/scripts/",
    "source": "node scripts/source-api.mjs",
    "source:test": "node --test scripts/source-api-cli.test.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
