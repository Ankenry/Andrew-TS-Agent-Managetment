+/// One presentation sample. Capacity is runtime metadata, never a config estimate.
+/// Unknown is distinct from a measured zero. The native /status helper owns the percentage.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub(crate) enum ContextProgressSnapshot {
+    #[default]
+    Unknown,
+    Known {
+        used: i64,
+        window: i64,
+        remaining: i64,
+    },
+}
+
+impl ContextProgressSnapshot {
+    pub(crate) fn from_info(info: &TokenUsageInfo) -> Self {
+        let Some(window) = info.model_context_window.filter(|window| *window > 0) else {
+            return Self::Unknown;
+        };
+        let used = info.last_token_usage.tokens_in_context_window();
+        if used < 0 {
+            return Self::Unknown;
+        }
+        Self::Known {
+            used,
+            window,
+            remaining: info
+                .last_token_usage
+                .percent_of_context_window_remaining(window),
+        }
+    }
+}
+
+/// Metadata-only lifecycle gate for the composer. No conversation, file watcher or backend call.
+/// Token notifications carry a thread/turn but no model ID: after a model change we conservatively
+/// wait for a distinct live turn and its sample. Replayed samples cannot establish live capacity.
+#[derive(Debug, Default)]
+pub(crate) struct ContextProgressState {
+    pub(crate) snapshot: ContextProgressSnapshot,
+    thread: Option<String>,
+    model: Option<String>,
+    turn: Option<String>,
+    waiting_for_turn: bool,
+    epoch: u64,
+    review: Option<(u64, ContextProgressSnapshot)>,
+    compaction_turn: Option<String>,
+}
+
+impl ContextProgressState {
+    pub(crate) fn bind(&mut self, thread: Option<String>) {
+        self.thread = thread;
+        self.turn = None;
+        self.waiting_for_turn = false;
+        self.compaction_turn = None;
+        self.review = None;
+        self.invalidate();
+    }
+
+    pub(crate) fn sync_model(&mut self, model: &str) {
+        if self.model.as_deref().is_some_and(|old| old != model) {
+            self.invalidate();
+            self.waiting_for_turn = true;
+        }
+        self.model = Some(model.to_owned());
+    }
+
+    pub(crate) fn invalidate(&mut self) {
+        self.epoch = self.epoch.wrapping_add(1);
+        self.snapshot = ContextProgressSnapshot::Unknown;
+    }
+
+    pub(crate) fn turn_started(&mut self, thread: &str, turn: &str, replay: bool) {
+        if replay || self.thread.as_deref() != Some(thread) {
+            return;
+        }
+        if self.turn.as_deref() != Some(turn) {
+            self.waiting_for_turn = false;
+            self.turn = Some(turn.to_owned());
+        }
+    }
+
+    pub(crate) fn receive(
+        &mut self,
+        thread: &str,
+        turn: &str,
+        info: &TokenUsageInfo,
+        replay: bool,
+    ) {
+        if replay
+            || self.thread.as_deref() != Some(thread)
+            || self.waiting_for_turn
+            || self.review.is_some()
+            || self.turn.as_deref().is_some_and(|current| current != turn)
+        {
+            return;
+        }
+        self.turn = Some(turn.to_owned());
+        self.snapshot = ContextProgressSnapshot::from_info(info);
+    }
+
+    pub(crate) fn compact_started(&mut self, turn: Option<&str>) {
+        self.compaction_turn = turn.map(str::to_owned);
+        self.invalidate();
+    }
+
+    /// Old servers can emit only this completion event. Ignore a duplicate/late completion of a
+    /// modern compaction, so a fresh post-compaction token sample is not erased.
+    pub(crate) fn legacy_compacted(&mut self, thread: &str, turn: &str) {
+        if self.thread.as_deref() == Some(thread)
+            && !self.turn.as_deref().is_some_and(|current| current != turn)
+            && self.compaction_turn.as_deref() != Some(turn)
+        {
+            self.compact_started(Some(turn));
+        }
+    }
+
+    pub(crate) fn begin_review(&mut self) {
+        if self.review.is_none() {
+            self.review = Some((self.epoch, self.snapshot));
+            self.snapshot = ContextProgressSnapshot::Unknown;
+        }
+    }
+
+    pub(crate) fn end_review(&mut self) {
+        if let Some((epoch, snapshot)) = self.review.take() {
+            self.snapshot = if epoch == self.epoch && !self.waiting_for_turn {
+                snapshot
+            } else {
+                ContextProgressSnapshot::Unknown
+            };
+        }
+    }
+}
