+#[cfg(test)]
+mod context_progress_tests {
+    use super::*;
+    fn info(used: i64, window: Option<i64>) -> TokenUsageInfo {
+        TokenUsageInfo {
+            total_token_usage: TokenUsage {
+                total_tokens: 9_999_999,
+                ..Default::default()
+            },
+            last_token_usage: TokenUsage {
+                total_tokens: used,
+                ..Default::default()
+            },
+            model_context_window: window,
+        }
+    }
+    fn state() -> ContextProgressState {
+        let mut state = ContextProgressState::default();
+        state.bind(Some("thread-a".to_owned()));
+        state.sync_model("model-a");
+        state
+    }
+    #[test]
+    fn context_progress_matches_native_status_last_not_cumulative() {
+        for (used, window) in [
+            (0, 828_400),
+            (191_000, 828_400),
+            (12_000, 12_000),
+            (10, 100),
+            (900_000, 828_400),
+            (i64::MAX, i64::MAX),
+        ] {
+            let info = info(used, Some(window));
+            assert_eq!(
+                ContextProgressSnapshot::from_info(&info),
+                ContextProgressSnapshot::Known {
+                    used,
+                    window,
+                    remaining: info
+                        .last_token_usage
+                        .percent_of_context_window_remaining(window),
+                }
+            );
+        }
+        assert_eq!(
+            ContextProgressSnapshot::from_info(&info(191_000, Some(828_400))),
+            ContextProgressSnapshot::Known {
+                used: 191_000,
+                window: 828_400,
+                remaining: 78
+            }
+        );
+        for info in [
+            info(-1, Some(100)),
+            info(0, None),
+            info(0, Some(0)),
+            info(0, Some(-1)),
+        ] {
+            assert_eq!(
+                ContextProgressSnapshot::from_info(&info),
+                ContextProgressSnapshot::Unknown
+            );
+        }
+    }
+    #[test]
+    fn context_progress_thread_replay_model_and_turn_gate() {
+        let mut s = state();
+        let i = info(20_000, Some(100_000));
+        s.receive("thread-b", "turn-1", &i, false);
+        s.receive("thread-a", "turn-1", &i, true);
+        assert_eq!(s.snapshot, ContextProgressSnapshot::Unknown);
+        s.receive("thread-a", "turn-1", &i, false);
+        assert_eq!(s.snapshot, ContextProgressSnapshot::from_info(&i));
+        s.sync_model("model-b");
+        s.turn_started("thread-a", "turn-1", false);
+        s.receive("thread-a", "turn-1", &i, false);
+        assert_eq!(s.snapshot, ContextProgressSnapshot::Unknown);
+        s.turn_started("thread-a", "turn-2", false);
+        s.receive("thread-a", "turn-1", &i, false);
+        assert_eq!(s.snapshot, ContextProgressSnapshot::Unknown);
+        s.receive("thread-a", "turn-2", &i, false);
+        assert_eq!(s.snapshot, ContextProgressSnapshot::from_info(&i));
+        s.bind(Some("thread-b".to_owned()));
+        s.receive("thread-a", "turn-2", &i, false);
+        assert_eq!(s.snapshot, ContextProgressSnapshot::Unknown);
+    }
+    #[test]
+    fn context_progress_compact_late_completion_and_review_epochs() {
+        let mut s = state();
+        let i = info(20_000, Some(100_000));
+        s.receive("thread-a", "turn-1", &i, false);
+        s.begin_review();
+        s.receive("thread-a", "turn-1", &info(99_999, Some(100_000)), false);
+        assert_eq!(s.snapshot, ContextProgressSnapshot::Unknown);
+        s.end_review();
+        assert_eq!(s.snapshot, ContextProgressSnapshot::from_info(&i));
+        s.compact_started(Some("turn-1"));
+        assert_eq!(s.snapshot, ContextProgressSnapshot::Unknown);
+        s.receive("thread-a", "turn-1", &i, false);
+        s.legacy_compacted("thread-a", "turn-1");
+        assert_eq!(s.snapshot, ContextProgressSnapshot::from_info(&i));
+        // Two modern compactions in one turn both invalidate; completion does not.
+        s.compact_started(Some("turn-1"));
+        assert_eq!(s.snapshot, ContextProgressSnapshot::Unknown);
+        s.receive("thread-a", "turn-1", &i, false);
+        s.begin_review();
+        s.sync_model("model-b");
+        s.end_review();
+        assert_eq!(s.snapshot, ContextProgressSnapshot::Unknown);
+    }
+    #[test]
+    fn context_progress_invalid_sample_replaces_prior_and_legacy_is_idempotent() {
+        let mut s = state();
+        let i = info(20_000, Some(100_000));
+        s.receive("thread-a", "turn-1", &i, false);
+        s.receive("thread-a", "turn-1", &info(0, None), false);
+        assert_eq!(s.snapshot, ContextProgressSnapshot::Unknown);
+        s.legacy_compacted("thread-a", "turn-1");
+        s.receive("thread-a", "turn-1", &i, false);
+        s.legacy_compacted("thread-a", "turn-1");
+        assert_eq!(s.snapshot, ContextProgressSnapshot::from_info(&i));
+        s.legacy_compacted("thread-a", "older-turn");
+        assert_eq!(s.snapshot, ContextProgressSnapshot::from_info(&i));
+        s.invalidate();
+        assert_eq!(s.snapshot, ContextProgressSnapshot::Unknown);
+    }
+}
