+//! Native notification/lifecycle integration tests; not part of the lightweight standalone harness.
+use super::*;
+use crate::token_usage::ContextProgressSnapshot;
+use codex_app_server_protocol::{
+    ThreadTokenUsage, ThreadTokenUsageUpdatedNotification, TokenUsageBreakdown,
+};
+
+fn token(thread: &str, turn: &str, used: i64) -> ServerNotification {
+    let last = TokenUsageBreakdown {
+        total_tokens: used,
+        input_tokens: used,
+        cached_input_tokens: 0,
+        cache_write_input_tokens: 0,
+        output_tokens: 0,
+        reasoning_output_tokens: 0,
+    };
+    let total = TokenUsageBreakdown {
+        total_tokens: 9_000_000,
+        ..last.clone()
+    };
+    ServerNotification::ThreadTokenUsageUpdated(ThreadTokenUsageUpdatedNotification {
+        thread_id: thread.into(),
+        turn_id: turn.into(),
+        token_usage: ThreadTokenUsage {
+            total,
+            last,
+            model_context_window: Some(828_400),
+        },
+    })
+}
+fn bind(chat: &mut ChatWidget) -> String {
+    let id = ThreadId::new();
+    chat.thread_id = Some(id);
+    chat.context_progress.bind(Some(id.to_string()));
+    chat.sync_context_progress_model();
+    id.to_string()
+}
+
+#[tokio::test]
+async fn context_progress_native_notifications_wrong_thread_resume_and_model() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(None).await;
+    let id = bind(&mut chat);
+    chat.handle_server_notification(
+        token(&id, "one", 191_000),
+        Some(ReplayKind::ResumeInitialMessages),
+    );
+    assert_eq!(
+        chat.context_progress.snapshot,
+        ContextProgressSnapshot::Unknown
+    );
+    chat.handle_server_notification(token(&id, "one", 191_000), None);
+    let expected = ContextProgressSnapshot::Known {
+        used: 191_000,
+        window: 828_400,
+        remaining: 78,
+    };
+    assert_eq!(chat.context_progress.snapshot, expected);
+    let native_before = chat.token_info.clone();
+    chat.handle_server_notification(token(&ThreadId::new().to_string(), "one", 99), None);
+    assert_eq!(chat.context_progress.snapshot, expected);
+    assert_eq!(chat.token_info, native_before);
+    chat.set_model("context-test-other-model");
+    chat.handle_server_notification(token(&id, "one", 20_000), None);
+    assert_eq!(
+        chat.context_progress.snapshot,
+        ContextProgressSnapshot::Unknown
+    );
+    handle_turn_started(&mut chat, "two");
+    chat.handle_server_notification(token(&id, "one", 20_000), None);
+    assert_eq!(
+        chat.context_progress.snapshot,
+        ContextProgressSnapshot::Unknown
+    );
+    chat.handle_server_notification(token(&id, "two", 191_000), None);
+    assert_eq!(chat.context_progress.snapshot, expected);
+    chat.clear_token_usage();
+    assert_eq!(
+        chat.context_progress.snapshot,
+        ContextProgressSnapshot::Unknown
+    );
+    let new_id = bind(&mut chat);
+    assert_ne!(id, new_id);
+    chat.handle_server_notification(token(&id, "two", 191_000), None);
+    assert_eq!(
+        chat.context_progress.snapshot,
+        ContextProgressSnapshot::Unknown
+    );
+}
+
+#[tokio::test]
+async fn context_progress_native_compaction_review_and_late_completion() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(None).await;
+    let id = bind(&mut chat);
+    handle_turn_started(&mut chat, "one");
+    chat.handle_server_notification(token(&id, "one", 191_000), None);
+    let before = chat.context_progress.snapshot;
+    chat.handle_server_notification(
+        ServerNotification::ItemStarted(ItemStartedNotification::new(
+            id.clone(),
+            "one".into(),
+            AppServerThreadItemPayload::ContextCompaction {
+                id: "compact".into(),
+            },
+            0,
+        )),
+        None,
+    );
+    assert_eq!(
+        chat.context_progress.snapshot,
+        ContextProgressSnapshot::Unknown
+    );
+    chat.handle_server_notification(token(&id, "one", 191_000), None);
+    chat.handle_server_notification(
+        ServerNotification::ItemCompleted(ItemCompletedNotification::new(
+            id.clone(),
+            "one".into(),
+            AppServerThreadItemPayload::ContextCompaction {
+                id: "compact".into(),
+            },
+            None,
+            0,
+        )),
+        None,
+    );
+    assert_eq!(chat.context_progress.snapshot, before);
+    chat.enter_review_mode_with_hint("fixture".into(), false);
+    assert_eq!(
+        chat.context_progress.snapshot,
+        ContextProgressSnapshot::Unknown
+    );
+    chat.handle_server_notification(token(&id, "one", 700_000), None);
+    chat.exit_review_mode_after_item();
+    assert_eq!(chat.context_progress.snapshot, before);
+    chat.enter_review_mode_with_hint("fixture".into(), false);
+    chat.set_model("context-test-other-model");
+    chat.exit_review_mode_after_item();
+    assert_eq!(
+        chat.context_progress.snapshot,
+        ContextProgressSnapshot::Unknown
+    );
+}
