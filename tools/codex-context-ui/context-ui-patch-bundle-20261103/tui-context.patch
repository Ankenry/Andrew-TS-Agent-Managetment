+//! Full composer integration suite. Requires codex-tui's test binary; the standalone text harness
+//! deliberately does not claim these tests or the VT100 backend ran.
+use super::*;
+use crate::token_usage::ContextProgressSnapshot;
+use tokio::sync::mpsc::unbounded_channel;
+
+fn composer() -> ChatComposer {
+    let (tx, _) = unbounded_channel();
+    let mut c = ChatComposer::new(
+        true,
+        AppEventSender::new(tx),
+        false,
+        "Ask Codex".into(),
+        true,
+    );
+    c.context_progress = Some(ContextProgressSnapshot::Known {
+        used: 191_000,
+        window: 828_400,
+        remaining: 78,
+    });
+    c
+}
+
+#[test]
+fn context_progress_layout_cursor_matrix() {
+    for width in [20, 40, 80, 120] {
+        for height in [1, 2, 3, 6, 24] {
+            for draft in ["hello", "Tiếng Việt 界 👋\nsecond\nthird"] {
+                let mut c = composer();
+                c.set_text_content(draft.into(), vec![], vec![]);
+                let options = ComposerRenderOptions::default();
+                let area = Rect::new(0, 0, width, height);
+                let layout = c.layout_with_options(area, options);
+                let mut buffer = Buffer::empty(area);
+                c.render_with_options(area, &mut buffer, None, options);
+                assert!(layout.context_progress.height <= 1);
+                assert_eq!(layout.context_progress.bottom(), layout.composer.y);
+                if height <= 3 {
+                    assert_eq!(layout.context_progress.height, 0);
+                }
+                if let Some((x, y)) = c.cursor_pos_with_options(area, options) {
+                    assert!(x < area.right() && y < area.bottom());
+                    assert!(y >= layout.context_progress.bottom());
+                }
+                let with = c.desired_height_with_options(width, options);
+                c.context_progress = None;
+                assert_eq!(with, c.desired_height_with_options(width, options) + 1);
+            }
+        }
+    }
+}
+
+#[test]
+fn context_progress_popups_voice_images_and_theme() {
+    use crate::bottom_pane::voice_strip::{VoiceStripPhase, VoiceStripState};
+    for (fg, bg) in [
+        ((20, 20, 20), (245, 245, 245)),
+        ((235, 235, 235), (20, 20, 20)),
+    ] {
+        crate::terminal_palette::with_test_default_colors(
+            crate::terminal_probe::DefaultColors { fg, bg },
+            || {
+                for placement in [
+                    CommandPopupPlacement::AboveComposer,
+                    CommandPopupPlacement::Overlay,
+                    CommandPopupPlacement::Hidden,
+                ] {
+                    for voice in [false, true] {
+                        let mut c = composer();
+                        c.handle_key_event(KeyEvent::new(KeyCode::Char('/'), KeyModifiers::NONE));
+                        assert!(c.popups.active.is_above_composer());
+                        c.set_remote_image_urls(vec!["https://example.invalid/image.png".into()]);
+                        if voice {
+                            c.set_voice_strip(
+                                Some(VoiceStripState {
+                                    mute_hint: None,
+                                    phase: VoiceStripPhase::Active,
+                                    microphone_live: true,
+                                    microphone_muted: false,
+                                    microphone_history: vec![0, 100, 255],
+                                    speaker_history: vec![255, 100, 0],
+                                    activity: "listening",
+                                    animations: false,
+                                    progress: true,
+                                }),
+                                FrameRequester::test_dummy(),
+                            );
+                        }
+                        let options = c.resolve_render_options(ComposerRenderOptions {
+                            command_popup_placement: placement,
+                            ..Default::default()
+                        });
+                        let area = Rect::new(0, 10, 80, c.desired_height_with_options(80, options));
+                        let l = c.layout_with_options(area, options);
+                        assert_eq!(l.context_progress.height, 1);
+                        assert_eq!(l.context_progress.bottom(), l.composer.y);
+                        if placement == CommandPopupPlacement::AboveComposer {
+                            assert!(l.popup.bottom() <= l.context_progress.y);
+                        }
+                        let mut buf = Buffer::empty(Rect::new(0, 0, 80, area.bottom()));
+                        c.render_with_options(area, &mut buf, None, options);
+                        let row: String = (0..80)
+                            .map(|x| buf[(x, l.context_progress.y)].symbol())
+                            .collect();
+                        assert!(
+                            row.contains("191K/828K"),
+                            "popup must not overwrite context: {row}"
+                        );
+                        assert!(l.textarea.y >= l.composer.y);
+                        assert!(l.remote_images.y >= l.composer.y);
+                    }
+                }
+            },
+        );
+    }
+}
+
+#[test]
+fn context_progress_vt100_resize_matrix() {
+    for (width, height) in [(80, 24), (20, 6), (40, 3), (120, 24)] {
+        let mut c = composer();
+        c.set_text_content("Tiếng Việt 界\nsecond line".into(), vec![], vec![]);
+        let mut terminal =
+            ratatui::Terminal::new(crate::test_backend::VT100Backend::new(width, height)).unwrap();
+        terminal
+            .draw(|frame| {
+                let area = frame.area();
+                c.render_with_options(
+                    area,
+                    frame.buffer_mut(),
+                    None,
+                    ComposerRenderOptions::default(),
+                );
+                if let Some((x, y)) =
+                    c.cursor_pos_with_options(area, ComposerRenderOptions::default())
+                {
+                    frame.set_cursor_position((x, y));
+                }
+            })
+            .unwrap();
+        let screen = terminal.backend().to_string();
+        if height >= 6 {
+            assert!(screen.contains("191K/828K"), "{screen}");
+        } else {
+            assert!(!screen.contains("Context:"));
+        }
+    }
+}
