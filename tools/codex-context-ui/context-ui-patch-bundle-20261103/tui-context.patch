+//! Width-aware text for the native above-composer row. Painting/theme and geometry remain owned
+//! by ChatComposer. The formatter is the existing /status formatter; no second token formula.
+use crate::token_usage::ContextProgressSnapshot;
+use unicode_width::UnicodeWidthStr;
+
+pub(super) fn line(
+    snapshot: ContextProgressSnapshot,
+    width: u16,
+    format_tokens: impl Fn(i64) -> String,
+) -> String {
+    let width = usize::from(width);
+    if width == 0 {
+        return String::new();
+    }
+    let ContextProgressSnapshot::Known {
+        used,
+        window,
+        remaining,
+    } = snapshot
+    else {
+        return ["Context: unknown", "Ctx ?", "?"]
+            .into_iter()
+            .find(|text| text.width() <= width)
+            .unwrap_or("")
+            .to_owned();
+    };
+    let used = format_tokens(used);
+    let window = format_tokens(window);
+    let labels = [
+        format!("Context: {used}/{window} • {remaining}% left"),
+        format!("{used}/{window} {remaining}%"),
+        format!("Ctx {remaining}%"),
+        format!("{remaining}%"),
+    ];
+    // Prefer a complete used/usable label and at least two bar cells. Very narrow panes may omit
+    // the bar or the counts, never truncate a number into a different measurement.
+    let label = labels
+        .iter()
+        .find(|label| label.width() + 5 <= width)
+        .or_else(|| labels.iter().find(|label| label.width() <= width));
+    let Some(label) = label else {
+        return "?".to_owned();
+    };
+    let spare = width.saturating_sub(label.width());
+    if spare < 5 {
+        return label.clone();
+    }
+    let cells = spare - 3; // one space plus brackets
+    let filled = (cells * remaining.clamp(0, 100) as usize + 50) / 100;
+    format!(
+        "{label} [{}{}]",
+        "#".repeat(filled),
+        "-".repeat(cells - filled)
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn context_progress_widths_unknown_and_measured_zero_are_distinct() {
+        for width in 0..=120 {
+            for sample in [
+                ContextProgressSnapshot::Unknown,
+                ContextProgressSnapshot::Known {
+                    used: 0,
+                    window: 100,
+                    remaining: 100,
+                },
+                ContextProgressSnapshot::Known {
+                    used: 200,
+                    window: 100,
+                    remaining: 0,
+                },
+            ] {
+                let text = line(sample, width, |n| n.to_string());
+                assert!(text.width() <= usize::from(width), "{width}: {text}");
+                assert!(!text.contains('\n'));
+            }
+        }
+        assert_eq!(
+            line(ContextProgressSnapshot::Unknown, 40, |n| n.to_string()),
+            "Context: unknown"
+        );
+        let zero = line(
+            ContextProgressSnapshot::Known {
+                used: 0,
+                window: 100,
+                remaining: 100,
+            },
+            40,
+            |n| n.to_string(),
+        );
+        assert!(zero.contains("0/100"));
+        assert!(zero.contains("100%"));
+        assert!(!zero.contains('-'));
+    }
+
+    #[test]
+    fn context_progress_text_and_bar_use_one_sample_and_unicode_cell_width() {
+        let s = ContextProgressSnapshot::Known {
+            used: 25,
+            window: 100,
+            remaining: 75,
+        };
+        let text = line(s, 40, |n| n.to_string());
+        assert!(text.contains("25/100 • 75% left"));
+        let bar = text.split('[').nth(1).unwrap().trim_end_matches(']');
+        assert_eq!(bar.matches('#').count(), (bar.len() * 75 + 50) / 100);
+        for width in [20, 40, 80, 120] {
+            let text = line(s, width, |n| format!("界{n}"));
+            assert!(text.width() <= usize::from(width));
+        }
+    }
+}
